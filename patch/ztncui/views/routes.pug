extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid
  - const networkRoutes = network.routes || []

  .card.table-card
    .table-wrap
      table.data-table
        thead
          tr
            th Target
            th Gateway
            th
        tbody
          each route in networkRoutes
            tr
              td.mono(data-label='Target')= route.target
              td.mono(data-label='Gateway')= route.via || '—'
              td.actions(data-label='Actions')
                a.btn.btn-sm.btn-danger(href=nwurl + '/routes/' + route.target + '/delete', data-confirm='Delete this managed route?') Delete
          else
            tr
              td(colspan='3')
                .empty-inline No managed routes yet.

  .card.form-card
    h2 Add route
    form.form-stack(method='POST', action=nwurl + '/routes')
      .field
        label(for='target') Target (CIDR)
        input#target(type='text', name='target', placeholder='10.42.0.0/24', value=(typeof route === 'undefined' ? '' : route.target), required)
      .field
        label(for='via') Gateway (optional)
        input#via(type='text', name='via', placeholder='10.42.0.1', value=(typeof route === 'undefined' ? '' : (route.via || '')))
      .form-actions
        button.btn.btn-primary(type='submit') Add route
        a.btn.btn-ghost(href=nwurl) Cancel

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
