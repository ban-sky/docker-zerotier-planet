extends users_layout

block users_content
  if user === null
    .alert.alert-warn No such user.
  else if self_delete === true
    .alert.alert-error You may not delete your own account.
  else if deleted
    .alert.alert-success #{user.name} was deleted.
  else
    .card.form-card
      h2 Delete user
      p.card-subtitle This cannot be undone. The last admin cannot be deleted.
      form.form-stack(method='POST', action='')
        .form-actions
          button.btn.btn-danger(type='submit', name='delete', value='delete') Delete #{user.name}
          a.btn.btn-ghost(href='/users') Cancel

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
