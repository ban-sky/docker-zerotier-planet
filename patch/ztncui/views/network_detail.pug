extends network_layout

block net_content
  - const nwurl = '/controller/network/' + network.nwid

  .toolbar
    a.btn.btn-sm(href=nwurl + '/private')= network.private ? 'Private network' : 'Public network'
    a.btn.btn-sm(href=nwurl + '/easy') Easy setup
    a.btn.btn-sm(href=nwurl + '/routes') Routes
    a.btn.btn-sm(href=nwurl + '/ipAssignmentPools') Assignment pools
    a.btn.btn-sm(href=nwurl + '/v4AssignMode') IPv4 mode
    a.btn.btn-sm(href=nwurl + '/v6AssignMode') IPv6 mode
    a.btn.btn-sm(href=nwurl + '/dns') DNS

  if members !== undefined
    .card.table-card
      .card-head
        div
          h2 Members
          p.card-subtitle #{members.length} device#{members.length === 1 ? '' : 's'} on this network
        a.btn.btn-sm.btn-ghost(href='') Refresh
      .table-wrap
        table.data-table.members-table
          thead
            tr
              th Member
              th.mono ID
              th Authorized
              th Active bridge
              th IP assignments
              th Status
          tbody
            each member in members
              - const peer = member.peer
              - const online = peer && typeof peer.latency === 'number' && peer.latency !== -1
              - const memberUrl = nwurl + '/member/' + member.id
              tr
                td(data-label='Member')
                  form.inline-form(method='POST', action=nwurl + '/members')
                    input(type='hidden', name='id', value=member.id)
                    input.input.input-sm(type='text', name='name', value=member.name, maxlength='128', aria-label='Member name for ' + member.id)
                    button.btn.btn-sm.btn-ghost(type='submit') Save
                  a.text-danger(href=memberUrl + '/delete', data-confirm='Remove this member from the network?') Remove
                td.mono(data-label='ID')
                  a(href=memberUrl)= member.id
                td(data-label='Authorized')
                  form.inline-form(method='POST', action=nwurl + '/members')
                    input(type='hidden', name='id', value=member.id)
                    select.input.input-sm(name='auth', data-autosubmit, aria-label='Authorization for ' + member.id)
                      option(value='true', selected=member.authorized ? true : false) Authorized
                      option(value='false', selected=!member.authorized) Not authorized
                td(data-label='Active bridge')
                  form.inline-form(method='POST', action=nwurl + '/members')
                    input(type='hidden', name='id', value=member.id)
                    select.input.input-sm(name='activeBridge', data-autosubmit, aria-label='Active bridge for ' + member.id)
                      option(value='true', selected=member.activeBridge ? true : false) Enabled
                      option(value='false', selected=!member.activeBridge) Disabled
                td(data-label='IP assignments')
                  if member.ipAssignments.length
                    each ipAssignment in member.ipAssignments
                      a.chip(href=memberUrl + '/ipAssignments')= ipAssignment
                  else
                    a.chip.chip-muted(href=memberUrl + '/ipAssignments') Assign IP
                td(data-label='Status')
                  if member.id == zt_address
                    span.badge.badge-ok Controller
                  else if online
                    span.badge.badge-ok Online
                    if peer.version
                      span.peer-meta v#{peer.version}
                  else if peer
                    span.badge.badge-warn Relay / offline
                    if peer.latency
                      span.peer-meta #{peer.latency} ms
                  else
                    span.badge.badge-muted Offline
                  if peer && peer.paths
                    each path in peer.paths
                      if path.preferred
                        span.peer-path= path.address
                        - break
      if members.length === 0
        .empty-inline
          p No members yet. Invite a device to join #[code= network.nwid].

  .card.detail-card
    .card-head
      h2 Network properties
      p.card-subtitle Click an editable property to open its settings page.
    dl.detail-list
      each value, key in network
        - const editable = ['dns', 'ipAssignmentPools', 'private', 'routes', 'v4AssignMode', 'v6AssignMode'].includes(key)
        .detail-row
          dt
            if editable
              a(href=nwurl + '/' + key)= key
            else
              span= key
          dd
            +json_value(value)

  a.btn.btn-ghost(href='/controller/networks') All networks
