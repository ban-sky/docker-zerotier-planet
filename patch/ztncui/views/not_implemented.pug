extends network_layout

block net_content
  .card
    h2 Not available in this UI
    p
      | Editing 
      strong= title
      |  is not implemented here.
    if member !== undefined
      p
        a(href='/controller/network/' + network.nwid + '/member/' + (member.id || member.address)) Open member details
    p
      | Most member settings are available on the 
      a(href='/controller/network/' + network.nwid + '#members') members page
      | .
