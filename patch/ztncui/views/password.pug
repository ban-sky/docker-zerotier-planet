extends users_layout

block users_content
  if message
    .alert.alert-info= message

  .card.form-card
    h2 Set password
    p.card-subtitle At least 10 characters. Argon2id hashes are stored with mode 0600.

    form.form-stack(method='POST', action='')
      .field
        label(for='username') Username
        input#username(type='text', name='username', value=user.name, readonly=readonly, autocomplete='username')
      .field
        label(for='password1') New password
        input#password1(type='password', name='password1', autocomplete='new-password', minlength='10', maxlength='160', required, autofocus)
      .field
        label(for='password2') Confirm password
        input#password2(type='password', name='password2', autocomplete='new-password', minlength='10', maxlength='160', required)
      label.check-row
        input#pass_set(type='checkbox', name='pass_set', value='check')
        span
          strong Require password change on next login
          span.check-hint Useful when creating an account for someone else.
      .form-actions
        button.btn.btn-primary(type='submit') Save password
        a.btn.btn-ghost(href='/users') Cancel

  if errors
    .alert.alert-error
      ul.list-tight
        each err in errors
          li= err.msg
